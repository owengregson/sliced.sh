{
	"name": "sliced-sh",
	"version": "2.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "bun scripts/build.ts",
		"gen:tokens": "bun scripts/gen-tokens.ts",
		"dev": "bun scripts/build.ts --dev --watch",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "bash scripts/test-runner.sh",
		"test:watch": "bun test --watch",
		"check": "bun run gen:tokens && bun run gen:pagescript && bun scripts/check-constants.ts && bun run lint && bun run typecheck && bun run test",
		"gen:pagescript": "bun scripts/gen-pagescript.ts",
		"verify:dist": "bun scripts/verify-dist.ts",
		"vendor:engine": "bun scripts/vendor-engine.ts"
	},
	"dependencies": {
		"chess.js": "^1.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.12",
		"@fortawesome/fontawesome-free": "^7.3.1",
		"@lichess-org/stockfish-web": "0.4.4",
		"@types/bun": "^1.3.12",
		"@types/chrome": "^0.1.36",
		"@types/estree": "^1.0.8",
		"archiver": "^7.0.1",
		"astring": "^1.9.0",
		"fake-indexeddb": "^6.2.5",
		"happy-dom": "^16.0.0",
		"typescript": "^5.9.3"
	},
	"engines": {
		"bun": ">=1.3.0"
	}
}
