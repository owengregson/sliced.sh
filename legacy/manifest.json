{
"update_url": "https://sliced.sh/update",

  "manifest_version": 2,
  "name": "sliced.sh",
  "description": "A powerful chess assistant that runs in your browser.",
  "version": "1.0",
  "icons": { "128": "./assets/images/sliced_128.png", "256": "./assets/images/sliced_256.png" },
  "content_scripts": [
    {
      "matches": [
        "*://*.chess.com/*",
        "*://*.lichess.org/*"
      ],
      "js": ["./SlicedEngine/build.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "page": "./pages/background.html"
  },
  "browser_action": {
    "default_popup": "./pages/login.html",
    "default_title": "sliced.gg"
  },
  "web_accessible_resources": ["./pages/background.html"],
  "content_security_policy": "script-src 'self' 'unsafe-eval'; object-src 'self'",
  "permissions": ["storage", "debugger"],
  "key": ""
}
